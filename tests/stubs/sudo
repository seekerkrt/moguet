#!/bin/sh
set -eu

is_typed_pacman_install() {
    [ "$#" -ge 4 ] && [ "${1:-}" = "pacman" ] && [ "${2:-}" = "-U" ] ||
        return 1
    shift 2

    if [ "${1:-}" = "--noconfirm" ]; then
        shift
    fi
    if [ "${1:-}" = "--needed" ]; then
        shift
    fi
    case ${1:-} in
        --asexplicit|--asdeps)
            shift
            ;;
    esac
    [ "$#" -ge 2 ] && [ "${1:-}" = "--" ] || return 1
    shift
    for install_artifact in "$@"; do
        [ -n "$install_artifact" ] || return 1
    done
}

require_known_pacman_argument_tail() {
    after_separator=0
    while [ "$#" -gt 0 ]; do
        if [ "$after_separator" -eq 1 ]; then
            shift
            continue
        fi
        case $1 in
            --)
                after_separator=1
                shift
                ;;
            --arch|--assume-installed|--cachedir|--color|--config|--dbpath|\
            --gpgdir|--hookdir|--ignore|--ignoregroup|--logfile|--overwrite|\
            --print-format|--root|--sysroot|-b|-r)
                [ "$#" -ge 2 ] || exit 2
                shift 2
                ;;
            --arch=*|--assume-installed=*|--cachedir=*|--color=*|--config=*|\
            --dbpath=*|--gpgdir=*|--hookdir=*|--ignore=*|--ignoregroup=*|\
            --logfile=*|--overwrite=*|--print-format=*|--root=*|--sysroot=*)
                shift
                ;;
            --noconfirm|--needed|--refresh|--search|--info|-s|-i|-y)
                shift
                ;;
            -*)
                exit 2
                ;;
            *)
                shift
                ;;
        esac
    done
}

require_sudo_argv() {
    if [ "$#" -lt 1 ]; then
        exit 2
    fi
    case $1 in
        pacman)
            [ "$#" -ge 2 ] || exit 2
            case ${2:-} in
                -U)
                    is_typed_pacman_install "$@" || exit 2
                    ;;
                -S|-Ss|-Ssy|-Si|-Siy|-Sc|-Sy|-Syy|-Su|-Syu|-R|-D|-F|-Fy|-Fyy)
                    shift 2
                    require_known_pacman_argument_tail "$@"
                    ;;
                *)
                    exit 2
                    ;;
            esac
            ;;
        *)
            exit 2
            ;;
    esac
}

printf 'sudo %s\n' "$*" >> "$MOGUET_TEST_COMMAND_LOG"
require_sudo_argv "$@"

exit_code=${MOGUET_TEST_SUDO_EXIT_CODE:-99}
if [ "$exit_code" -eq 0 ] && is_typed_pacman_install "$@"; then
    state_after_success_file=${MOGUET_TEST_MAKEPKG_PACKAGE_METADATA_STATE_AFTER_SUCCESS_FILE:-}
    metadata_state_file=${MOGUET_TEST_PACKAGE_METADATA_STATE_FILE:-}
    if [ -n "$state_after_success_file" ]; then
        if [ -z "$metadata_state_file" ] || [ ! -f "$state_after_success_file" ]; then
            exit 1
        fi
        # POLICY: fake install成功後だけcase-localなinstalled stateを更新する。
        /usr/bin/cp -- "$state_after_success_file" "$metadata_state_file" || exit 1
    fi
fi
exit "$exit_code"
