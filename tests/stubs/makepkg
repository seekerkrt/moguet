#!/bin/sh
set -eu

is_makepkg_environment_assignment() {
    case ${1:-} in
        *=*) makepkg_assignment_key=${1%%=*} ;;
        *) return 1 ;;
    esac
    case $makepkg_assignment_key in
        [A-Za-z_]* )
            case $makepkg_assignment_key in
                *[!A-Za-z0-9_]*) return 1 ;;
            esac
            ;;
        *) return 1 ;;
    esac
    return 0
}

require_makepkg_environment_assignments() {
    for makepkg_assignment in "$@"; do
        is_makepkg_environment_assignment "$makepkg_assignment" || exit 2
    done
}

require_makepkg_argv() {
    if [ "$#" -lt 1 ]; then
        exit 2
    fi
    if [ "${1:-}" = "--packagelist" ] ||
        [ "${1:-}" = "--printsrcinfo" ]; then
        shift
        require_makepkg_environment_assignments "$@"
        return
    fi
    if [ "${1:-}" != "-sc" ]; then
        exit 2
    fi

    shift
    if [ "${1:-}" = "--noconfirm" ]; then
        shift
    fi
    if [ "${1:-}" = "-f" ]; then
        shift
    fi
    if [ "${1:-}" = "-C" ]; then
        shift
    fi
    require_makepkg_environment_assignments "$@"
}

log_makepkg_options() {
    printf 'makepkg' >> "$MOGUET_TEST_COMMAND_LOG"
    for makepkg_option in "$@"; do
        if is_makepkg_environment_assignment "$makepkg_option"; then
            break
        fi
        printf ' %s' "$makepkg_option" >> "$MOGUET_TEST_COMMAND_LOG"
    done
    printf '\n' >> "$MOGUET_TEST_COMMAND_LOG"
}

require_makepkg_argv "$@"
log_makepkg_options "$@"

argument_index=0
if [ -n "${MOGUET_TEST_MAKEPKG_ARGV_LOG:-}" ]; then
    printf 'argv-begin\n' >> "$MOGUET_TEST_MAKEPKG_ARGV_LOG"
fi
for makepkg_arg in "$@"; do
    if [ -n "${MOGUET_TEST_MAKEPKG_ARGV_LOG:-}" ]; then
        printf 'arg[%s]=<%s>\n' "$argument_index" "$makepkg_arg" >> "$MOGUET_TEST_MAKEPKG_ARGV_LOG"
    fi
    argument_index=$((argument_index + 1))
done
if [ -n "${MOGUET_TEST_MAKEPKG_ARGV_LOG:-}" ]; then
    printf 'argv-end\n' >> "$MOGUET_TEST_MAKEPKG_ARGV_LOG"
fi
if [ -n "${MOGUET_TEST_MAKEPKG_ENV_LOG:-}" ]; then
    printf 'env-begin\n' >> "$MOGUET_TEST_MAKEPKG_ENV_LOG"
    for makepkg_env_key in ${MOGUET_TEST_MAKEPKG_ENV_KEYS:-}; do
        case $makepkg_env_key in
            [A-Za-z_]*)
                case $makepkg_env_key in
                    *[!A-Za-z0-9_]*) exit 2 ;;
                esac
                ;;
            *) exit 2 ;;
        esac
        if makepkg_env_value=$(/usr/bin/printenv "$makepkg_env_key"); then
            printf 'env[%s]=<%s>\n' "$makepkg_env_key" "$makepkg_env_value" \
                >> "$MOGUET_TEST_MAKEPKG_ENV_LOG"
        else
            printf 'env[%s]=<unset>\n' "$makepkg_env_key" \
                >> "$MOGUET_TEST_MAKEPKG_ENV_LOG"
        fi
    done
    printf 'env-end\n' >> "$MOGUET_TEST_MAKEPKG_ENV_LOG"
fi
if [ -n "${MOGUET_TEST_MAKEPKG_CWD_LOG:-}" ]; then
    /usr/bin/pwd >> "$MOGUET_TEST_MAKEPKG_CWD_LOG" || exit 1
fi
exit_code=${MOGUET_TEST_MAKEPKG_EXIT_CODE:-99}
observed_package_base=$(/usr/bin/basename -- "$(/usr/bin/pwd)") || exit 1
package_base=${MOGUET_TEST_MAKEPKG_PACKAGE_BASE:-$observed_package_base}
case $observed_package_base in
    .local-source-workspace~*)
        package_base=${MOGUET_TEST_MAKEPKG_LOCAL_PACKAGE_BASE:-$package_base}
        ;;
esac
default_artifact_path=${PKGDEST:+$PKGDEST/$package_base-1.0-1-x86_64.pkg.tar.zst}

if [ "$1" = "--printsrcinfo" ]; then
    if [ -n "${MOGUET_TEST_MAKEPKG_SRCINFO_OUTPUT_FILE:-}" ]; then
        /usr/bin/cat -- "$MOGUET_TEST_MAKEPKG_SRCINFO_OUTPUT_FILE" || exit 1
    fi
    exit "${MOGUET_TEST_MAKEPKG_PRINTSRCINFO_EXIT_CODE:-$exit_code}"
fi

configured_artifacts_for_package_base() {
    [ -n "${MOGUET_TEST_MAKEPKG_ARTIFACT_IDENTITIES:-}" ] || return 0
    printf '%s\n' "$MOGUET_TEST_MAKEPKG_ARTIFACT_IDENTITIES" |
        /usr/bin/awk -F '|' -v package_base="$package_base" '
            NF != 3 || $1 == "" || $2 == "" || $3 == "" {
                invalid = 1
                next
            }
            $1 == package_base { print $2 "|" $3 }
            END { if (invalid) exit 2 }
        '
}

configured_artifacts=$(configured_artifacts_for_package_base) || exit 2

if [ "$1" = "--packagelist" ]; then
    if [ -n "${MOGUET_TEST_MAKEPKG_PACKAGELIST_OUTPUT_FILE:-}" ]; then
        /usr/bin/cat -- "$MOGUET_TEST_MAKEPKG_PACKAGELIST_OUTPUT_FILE" || exit 1
    elif [ -n "$configured_artifacts" ]; then
        printf '%s\n' "$configured_artifacts" |
            while IFS='|' read -r artifact_name artifact_version; do
                printf '%s/%s-%s-x86_64.pkg.tar.zst\n' \
                    "$PKGDEST" "$artifact_name" "$artifact_version"
            done
    elif [ -n "$default_artifact_path" ]; then
        printf '%s\n' "$default_artifact_path"
    fi
    exit "${MOGUET_TEST_MAKEPKG_PACKAGELIST_EXIT_CODE:-$exit_code}"
fi

if [ "$1" = "-sc" ] && [ -n "${MOGUET_TEST_CLEANUP_DEPENDENCY_STATE_FILE:-}" ]; then
    # The cleanup full-CLI fixture models makepkg's dependency install separately
    # from the later root artifact install. Only case-local metadata is changed.
    /usr/bin/cp -- "$MOGUET_TEST_CLEANUP_DEPENDENCY_STATE_FILE" \
        "$MOGUET_TEST_CLEANUP_METADATA_STATE_FILE" || exit 1
fi

if [ "$exit_code" -eq 0 ] && [ "$1" = "-sc" ]; then
    if [ -n "${MOGUET_TEST_MAKEPKG_PACKAGELIST_OUTPUT_FILE:-}" ]; then
        artifact_path=$(/usr/bin/sed -n '1p' -- \
            "$MOGUET_TEST_MAKEPKG_PACKAGELIST_OUTPUT_FILE") || exit 1
        if [ -z "$artifact_path" ]; then
            exit 1
        fi
        printf '%s\t%s\n' "$package_base" '1.0-1' > "$artifact_path" || exit 1
    elif [ -n "$configured_artifacts" ]; then
        # POLICY(#268): one PackageBase build may create multiple ordered
        # artifacts. Each line is package-base|package-name|full-version.
        printf '%s\n' "$configured_artifacts" |
            while IFS='|' read -r artifact_name artifact_version; do
                artifact_path=$PKGDEST/$artifact_name-$artifact_version-x86_64.pkg.tar.zst
                printf '%s\t%s\n' "$artifact_name" "$artifact_version" \
                    > "$artifact_path" || exit 1
            done
    else
        artifact_path=$default_artifact_path
        if [ -z "$artifact_path" ]; then
            exit 1
        fi
        # POLICY: fake buildはowned PKGDESTにregular artifactだけを生成する。
        # installed stateの更新は後段のfake sudo pacman -Uが所有する。
        printf '%s\t%s\n' "$package_base" '1.0-1' > "$artifact_path" || exit 1
    fi
fi
exit "$exit_code"
