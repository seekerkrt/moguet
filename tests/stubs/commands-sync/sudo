#!/bin/sh
set -eu

is_typed_pacman_install() {
    [ "$#" -ge 4 ] && [ "${1:-}" = "pacman" ] && [ "${2:-}" = "-U" ] ||
        return 1
    shift 2

    if [ "${1:-}" = "--noconfirm" ]; then
        shift
    fi
    if [ "${1:-}" = "--needed" ]; then
        shift
    fi
    case ${1:-} in
        --asexplicit|--asdeps)
            shift
            ;;
    esac
    [ "$#" -ge 2 ] && [ "${1:-}" = "--" ] || return 1
    shift
    for install_artifact in "$@"; do
        [ -n "$install_artifact" ] || return 1
    done
}

install_artifacts() {
    after_separator=0
    for install_argument in "$@"; do
        if [ "$after_separator" -eq 1 ]; then
            printf '%s\n' "$install_argument"
        elif [ "$install_argument" = "--" ]; then
            after_separator=1
        fi
    done
}

require_commands_sync_pacman_argument_tail() {
    after_separator=0
    while [ "$#" -gt 0 ]; do
        if [ "$after_separator" -eq 1 ]; then
            shift
            continue
        fi
        case $1 in
            --)
                after_separator=1
                shift
                ;;
            --config)
                [ "$#" -ge 2 ] || exit 2
                shift 2
                ;;
            --config=*)
                shift
                ;;
            --noconfirm|--needed|--refresh|--sysupgrade|-y|-u)
                shift
                ;;
            -*)
                exit 2
                ;;
            *)
                shift
                ;;
        esac
    done
}

require_commands_sync_sudo_argv() {
    [ "$#" -ge 2 ] && [ "${1:-}" = "pacman" ] || exit 2
    case ${2:-} in
        -R)
            # The coordinated transition permits exactly one dependency-checked
            # removal. No recursive/cascade/nodeps option is a fixture shortcut.
            [ "$#" -eq 4 ] && [ "$3" = -- ] &&
                [ "$4" = virtualbox-ext-oracle ] &&
                [ -n "${MOGUET_TEST_CROSS_SOURCE_PHASE_FILE:-}" ] || exit 2
            ;;
        -U)
            is_typed_pacman_install "$@" || exit 2
            ;;
        -S|-Ss|-Ssy|-Si|-Sy|-Su|-Suy|-Syu|-Syux)
            shift 2
            require_commands_sync_pacman_argument_tail "$@"
            ;;
        *)
            exit 2
            ;;
    esac
}

printf 'sudo %s\n' "$*" >> "$MOGUET_TEST_COMMAND_LOG"
require_commands_sync_sudo_argv "$@"

if [ -n "${MOGUET_TEST_SUDO_MAIN_OUTPUT:-}" ]; then
    printf '%s\n' "$MOGUET_TEST_SUDO_MAIN_OUTPUT"
fi
exit_code=${MOGUET_TEST_SUDO_MAIN_STATUS:-99}
if [ -n "${MOGUET_TEST_CROSS_SOURCE_PHASE_FILE:-}" ]; then
    scenario=${MOGUET_TEST_CROSS_SOURCE_CASE:-success}
    case $2 in
        -R)
            if [ "$scenario" = removal-failure ]; then exit_code=31; fi
            ;;
        -Syu)
            if [ "$scenario" = repo-failure ]; then exit_code=37; fi
            ;;
        -U)
            if [ "$scenario" = install-failure ]; then exit_code=41; fi
            ;;
    esac
    if [ "$exit_code" -eq 0 ]; then
        state_file=$MOGUET_TEST_FOREIGN_PACKAGE_INVENTORY_STATE_FILE
        phase=
        case $2 in
            -R)
                /usr/bin/awk '$1 != "virtualbox-ext-oracle"' "$state_file" > "$state_file.next"
                phase=removed
                ;;
            -Syu)
                version=7.2.18-1
                if [ "$scenario" = repo-post-mismatch ]; then version=7.2.16-1; fi
                /usr/bin/awk -v version="$version" '
                    $1 == "virtualbox" { $2 = version }
                    { print }
                ' "$state_file" > "$state_file.next"
                phase=repository
                ;;
            -U)
                reason=explicit
                for option in "$@"; do
                    if [ "$option" = --asdeps ]; then reason=dependency; fi
                done
                if [ "$scenario" = post-reason ]; then
                    if [ "$reason" = explicit ]; then reason=dependency; else reason=explicit; fi
                fi
                version=7.2.18-1
                if [ "$scenario" = post-version ]; then version=7.2.16-1; fi
                /usr/bin/awk -v scenario="$scenario" '
                    $1 == "virtualbox-ext-oracle" { next }
                    $1 == "virtualbox" && scenario == "post-repo-version" { $2 = "7.2.16-1" }
                    { print }
                ' "$state_file" > "$state_file.next"
                printf 'virtualbox-ext-oracle %s %s\n' "$version" "$reason" >> "$state_file.next"
                phase=installed
                ;;
        esac
        if [ -n "$phase" ]; then
            /usr/bin/mv -- "$state_file.next" "$state_file"
            /usr/bin/awk '{print $1, $2}' "$state_file" > "$MOGUET_TEST_PACKAGE_METADATA_STATE_FILE"
            printf '%s\n' "$phase" > "$MOGUET_TEST_CROSS_SOURCE_PHASE_FILE"
            printf 'fixture phase %s\n' "$phase" >> "$MOGUET_TEST_COMMAND_LOG"
        fi
    fi
fi
if [ "$exit_code" -eq 0 ] && is_typed_pacman_install "$@"; then
    state_after_success_file=${MOGUET_TEST_MAKEPKG_PACKAGE_METADATA_STATE_AFTER_SUCCESS_FILE:-}
    metadata_state_file=${MOGUET_TEST_PACKAGE_METADATA_STATE_FILE:-}
    if [ -n "$state_after_success_file" ]; then
        if [ -z "$metadata_state_file" ] || [ ! -f "$state_after_success_file" ]; then
            exit 1
        fi
        /usr/bin/cp -- "$state_after_success_file" "$metadata_state_file" || exit 1
    fi

    installed_artifacts=$(install_artifacts "$@") || exit 1
    installed_artifact=$(printf '%s\n' "$installed_artifacts" | /usr/bin/sed -n '1p') || exit 1
    install_success_log=${MOGUET_TEST_PACMAN_U_SUCCESS_LOG:-}
    if [ -n "$install_success_log" ]; then
        if [ ! -f "$install_success_log" ] || [ -L "$install_success_log" ] ||
           [ "${install_success_log%/*}" != "$XDG_CACHE_HOME" ]; then
            exit 1
        fi
        printf '%s\n' "$installed_artifacts" > "$install_success_log" || exit 1
    fi

    if [ "${MOGUET_TEST_REPLACE_WORKSPACE_AFTER_PACMAN_U:-0}" = "1" ]; then
        workspace_path=${installed_artifact%/*}
        workspace_parent=${workspace_path%/*}
        workspace_leaf=${workspace_path##*/}
        displaced_workspace=${workspace_path}.installed-before-cleanup
        if [ -z "$install_success_log" ] ||
           [ "$workspace_path" = "$installed_artifact" ] ||
           [ "$workspace_parent" != "$XDG_CACHE_HOME/moguet" ] ||
           [ ! -d "$workspace_path" ] || [ -L "$workspace_path" ] ||
           [ ! -f "$installed_artifact" ] || [ -L "$installed_artifact" ] ||
           [ -e "$displaced_workspace" ] || [ -L "$displaced_workspace" ]; then
            exit 1
        fi
        case $workspace_leaf in
            .artifact-workspace~-??????) ;;
            *) exit 1 ;;
        esac
        # POLICY(#242): transaction成功後だけnamed pathを置換し、production
        # cleanupのidentity guardからreal partial-success exceptionを発生させる。
        /usr/bin/mv -- "$workspace_path" "$displaced_workspace" || exit 1
        /usr/bin/mkdir -m 700 -- "$workspace_path" || exit 1
    fi
fi
exit "$exit_code"
