msgstr "ビルド結果（{} {}）: 成功。"

#, c++-format
msgid "Install outcome for {} {}: not attempted."
msgstr "インストール結果（{} {}）: 未試行。"

#, c++-format
msgid "Install outcome for {} {}: started; completion was not proven."
msgstr "インストール結果（{} {}）: 開始済みですが、完了を証明できませんでした。"

