        word=${(Q)words[index]}
        if [[ $pending == true ]]; then pending=false; continue; fi
        case "$word" in
        --) return 1 ;;
        --arch|--assume-installed|--cachedir|--color|--config|--dbpath|--gpgdir|--hookdir|--ignore|--ignoregroup|--logfile|--overwrite|--print-format|--root|--sysroot|-b|-r) pending=true ;;
        esac
    done
    [[ $pending == false ]]
}

_moguet_query_context() {
    local seen=false pending=false word index
    for ((index=2; index<CURRENT; ++index)); do
        word=$words[index]
        [[ ${words_are_logical-false} == true ]] || word=${(Q)word}
        if [[ $pending == true ]]; then pending=false; continue; fi
        case "$word" in
        --) return 1 ;;
        -Q) [[ $seen == false ]] || return 1; seen=true ;;
        --noconfirm|--needed) continue ;;
        --arch|--assume-installed|--cachedir|--color|--config|--dbpath|--gpgdir|--hookdir|--ignore|--ignoregroup|--logfile|--overwrite|--print-format|--root|--sysroot|-b|-r) [[ $seen == true ]] || return 1; pending=true ;;
        --arch=*|--assume-installed=*|--cachedir=*|--color=*|--config=*|--dbpath=*|--gpgdir=*|--hookdir=*|--ignore=*|--ignoregroup=*|--logfile=*|--overwrite=*|--print-format=*|--root=*|--sysroot=*) [[ $seen == true ]] || return 1 ;;
        *) return 1 ;;
        esac
    done
    [[ $seen == true && $pending == false ]]
}


_moguet() {
    local operation candidate option_id cur=${PREFIX-${(Q)words[CURRENT]}}
    local words_are_logical=false
    local -a words=("${words[@]}")
    local -a candidates filtered described described_intercepted_pacman described_moguet_owned described_upstream_delegated
    local ownership
    _moguet_option_context || return 0
    case "$cur" in
    --build-mode=*)
        # Applicability and agreement consume the same logical prior words.
        local index
        for ((index=2; index<CURRENT; ++index)); do
            words[index]=${(Q)words[index]}
        done
        words_are_logical=true
        ;;
    esac
    _moguet_find_operation
    operation=$REPLY

    if [[ -z $operation ]]; then
        candidates=(build upgrade upgrade-aur upgrade-all clean deps plan fetch add-src edit-src list-src del-src revert add-patch update-patch del-patch list-patch -G -Gp -S -Syu -Su -Ss -Si -Qua -h --help -V --version --edit --noedit --diff --nodiff --noconfirm --dry-run --build-mode= --rebuild --cleanbuild --rmdeps --select --aur --repo --details)
    else
        _moguet_collect_candidates "$operation"
        candidates=("${reply[@]}")
    fi

    _moguet_typed_values && return 0

    for candidate in "${candidates[@]}"; do
        if _moguet_option_id "$candidate"; then
            option_id=$REPLY
            case "$option_id" in
            13|14|15|21|23|22|16)
                _moguet_has_option_id "$option_id" && continue
                ;;
            esac
            _moguet_conflicts_with_present_option "$option_id" && continue
        fi
        filtered+=("$candidate")
    done

    for candidate in "${filtered[@]}"; do
        _moguet_option_ownership "$candidate"
        ownership=$REPLY
        _moguet_description "$candidate"
        case "$ownership" in
        intercepted-pacman) described_intercepted_pacman+=("$candidate:$REPLY") ;;
        moguet-owned) described_moguet_owned+=("$candidate:$REPLY") ;;
        upstream-delegated) described_upstream_delegated+=("$candidate:$REPLY") ;;
        *) described+=("$candidate:$REPLY") ;;
        esac
    done
    _describe -t moguet-values 'moguet value' described
    _describe -J -t moguet-options-intercepted-pacman 'pacman-compatible options' described_intercepted_pacman
    _describe -J -t moguet-options-moguet-owned 'Moguet options' described_moguet_owned
    _describe -J -t moguet-options-upstream-delegated 'pacman delegated options' described_upstream_delegated
    # Package tokens use compadd directly, without description delimiters.
    if (( CURRENT == 3 && ${#words} == 3 )) && [[ $words[CURRENT] != -* ]]; then
        case "$words[2]" in
        -S)
            local prefix=${PREFIX-${(Q)words[CURRENT]}}
            [[ $prefix != -* ]] && _moguet_repository_packages "$prefix"
            ;;
        esac
    fi
    return 0
}

_moguet_repository_packages() {
    emulate -L zsh
    local prefix="$1" helper=@MOGUET_REPOSITORY_PREFIX_HELPER_ZSH@ output candidate previous=
    local LC_ALL=C
    local -a packages
    [[ $helper == /* && -x $helper ]] || return 0
    output="$("$helper" "$prefix" 2>/dev/null && printf '\001')" || return 0
    output=${output%$'\001'}
    (( ${#output} <= 65536 )) || return 0
    [[ $output != *$'\0'* ]] || return 0
    [[ -z $output ]] && return 0
    [[ $output == *$'\n' ]] || return 0
    packages=("${(@f)${output%$'\n'}}")
    (( ${#packages} <= 256 )) || return 0
    for candidate in "${packages[@]}"; do
        [[ $candidate =~ '^[A-Za-z0-9@._+][A-Za-z0-9@._+-]*$' &&
           $candidate != . && $candidate != .. &&
           $candidate == "$prefix"* ]] || return 0
        [[ -z $previous || $candidate > $previous ]] || return 0
        previous=$candidate
    done
    compadd -a packages
    return 0
}

compdef _moguet moguet
